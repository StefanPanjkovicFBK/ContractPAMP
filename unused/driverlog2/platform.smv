@TIME_DOMAIN continuous

MODULE T_DRIVELEFT

VAR location : {OFF, MOVING};
    __CLOCK__c : clock;
    start : boolean;
    end : boolean;

IVAR EVENT: {DRIVE_START, DRIVE_END, STUTTER};

INIT (location = OFF);

TRANS

(EVENT = STUTTER -> location = next(location) & __CLOCK__c = next(__CLOCK__c)) &

(EVENT = DRIVE_START -> location = OFF & next(location) = MOVING & next(__CLOCK__c) = 0) &

(EVENT = DRIVE_END -> location = MOVING & next(location) = OFF & __CLOCK__c = next(__CLOCK__c)) &

(start <-> EVENT = DRIVE_START) &

(end <-> EVENT = DRIVE_END);

MODULE T_DRIVERIGHT

VAR location : {OFF, MOVING};
    __CLOCK__c : clock;
    start : boolean;
    end : boolean;

IVAR EVENT: {DRIVE_START, DRIVE_END, STUTTER};

INIT (location = OFF);

TRANS

(EVENT = STUTTER -> location = next(location) & __CLOCK__c = next(__CLOCK__c)) &

(EVENT = DRIVE_START -> location = OFF & next(location) = MOVING & next(__CLOCK__c) = 0) &

(EVENT = DRIVE_END -> location = MOVING & next(location) = OFF & __CLOCK__c = next(__CLOCK__c)) &

(start <-> EVENT = DRIVE_START) &

(end <-> EVENT = DRIVE_END);

MODULE T_LOAD

VAR location : {OFF, LOADING};
    start : boolean;
    end : boolean;

IVAR EVENT : {LOAD_START, LOAD_END, STUTTER};

INIT (location = OFF);

TRANS

(EVENT = STUTTER -> location = next(location)) &

(EVENT = LOAD_START -> location = OFF & next(location) = LOADING) &

(EVENT = LOAD_END -> location = LOADING & next(location) = OFF) &

(start <-> EVENT = LOAD_START) &

(end <-> EVENT = LOAD_END);

MODULE T_UNLOAD

VAR location : {OFF, UNLOADING};
    start : boolean;
    end : boolean;

IVAR EVENT : {UNLOAD_START, UNLOAD_END, STUTTER};

INIT (location = OFF);

TRANS

(EVENT = STUTTER -> location = next(location)) &

(EVENT = UNLOAD_START -> location = OFF & next(location) = UNLOADING) &

(EVENT = UNLOAD_END -> location = UNLOADING & next(location) = OFF) &

(start <-> EVENT = UNLOAD_START) &

(end <-> EVENT = UNLOAD_END);


