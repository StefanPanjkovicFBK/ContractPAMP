instance Location L1, L2;

distance(L1, L1) := 0;
distance(L1, L2) := 0.1;

distance(L2, L1) := 0.1;
distance(L2, L2) := 0;

[start] robot_at(L1) := true;
[start] robot_at(L2) := false;

[start] msg_sent(L1) := false;
[start] msg_sent(L2) := false;

[end] robot_at(L2);
[end] not msg_sent(L1);
[end] msg_sent(L2);
