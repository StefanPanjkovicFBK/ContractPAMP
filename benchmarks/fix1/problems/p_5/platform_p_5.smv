@TIME_DOMAIN continuous

MODULE T_SWITCH

VAR location : {OFF, SWITCHING};
    start : boolean;
    end : boolean;

IVAR EVENT : {SWITCH_START, SWITCH_END, STUTTER};

INIT (location = OFF);

TRANS

(EVENT = STUTTER -> location = next(location)) &

(EVENT = SWITCH_START -> location = OFF & next(location) = SWITCHING) &

(EVENT = SWITCH_END -> location = SWITCHING & next(location) = OFF) &

(start <-> EVENT = SWITCH_START) &

(end <-> EVENT = SWITCH_END);

MODULE T_FIX

VAR location : {OFF, FIXING};
    start : boolean;
    end : boolean;

IVAR EVENT : {FIX_START, FIX_END, STUTTER};

INIT (location = OFF);

TRANS

(EVENT = STUTTER -> location = next(location)) &

(EVENT = FIX_START -> location = OFF & next(location) = FIXING) &

(EVENT = FIX_END -> location = FIXING & next(location) = OFF) &

(start <-> EVENT = FIX_START) &

(end <-> EVENT = FIX_END);

MODULE C_CONTROLLER

VAR location : {BROKEN, FIXED};
    x : real;

IVAR EVENT : {FIX, SWITCH, STUTTER};

INIT (location = FIXED) & (x = 5);

INVAR

(location = BROKEN -> x <= 4)

TRANS

(EVENT = STUTTER -> location = next(location) & x = next(x)) &

(EVENT = FIX -> (location = BROKEN & next(location) = BROKEN & next(x) = x + 1) | (location = BROKEN & next(location) = FIXED & next(x) = x + 1) | (location = FIXED & next(location) = FIXED & next(x) = x + 1)) &

(EVENT = SWITCH -> location = FIXED & next(location) = BROKEN & next(x) = 0);


MODULE main

VAR

global_clock : clock;

tswitch : T_SWITCH();

tfix : T_FIX();

ccontroller : C_CONTROLLER();

switch_running_ : boolean;

fix_running_ : boolean;

INIT

(global_clock = 0) &

(!switch_running_) & (!fix_running_);

INVAR

((!switch_running_) -> tswitch.location = OFF) &

((!fix_running_) -> tfix.location = OFF);

TRANS

(global_clock = next(global_clock)) &

((tswitch.EVENT = SWITCH_START) -> next(switch_running_)) &

((tswitch.EVENT = SWITCH_END) -> !next(switch_running_)) &

((tfix.EVENT = FIX_START) -> next(fix_running_)) &

((tfix.EVENT = FIX_END) -> !next(fix_running_)) &

(tswitch.EVENT = SWITCH_END <-> ccontroller.EVENT = SWITCH) &

(tfix.EVENT = FIX_END <-> ccontroller.EVENT = FIX);

