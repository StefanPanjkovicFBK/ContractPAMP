type Location;

constant rational distance_lb(Location l1, Location l2);
constant rational distance_ub(Location l1, Location l2);
constant rational id(Location l);

fluent boolean truck_at(Location l);
fluent rational loc_packages(Location l);
fluent rational truck_packages;
fluent boolean loading;

action driveleft(Location from, Location to) {
    duration >= distance_lb(from, to) and duration <= distance_ub(from, to);

    [start] id(from) > id(to);
    [start] truck_at(from);
    [start] truck_packages == 0;
    [start] truck_at(from) := false;

    [all] loading == false;

    [end] truck_at(to) := true;
};

action driveright(Location from, Location to) {
    duration >= distance_lb(from, to) and duration <= distance_ub(from, to);

    [start] id(from) < id(to);
    [start] truck_at(from);
    [start] truck_packages > 0;
    [start] truck_at(from) := false;

    [all] loading == false;

    [end] truck_at(to) := true;
};

action load(Location l) {
    duration := 1;

    [start] truck_at(l);
    [start] loc_packages(l) > 0;
    [start] loading == false;
    [start] loc_packages(l) := loc_packages(l) - 1;
    [start] loading := true;

    [end] truck_packages := truck_packages + 1;
    [end] loading := false;
};

action unload(Location l) {
    duration := 1;

    [start] truck_at(l);
    [start] truck_packages > 0;
    [start] loading == false;
    [start] truck_packages := truck_packages - 1;
    [start] loading := true;

    [end] loc_packages(l) := loc_packages(l) + 1;
    [end] loading := false;
};

