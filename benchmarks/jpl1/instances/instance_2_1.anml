instance Position pos1, pos2;
instance Body s1, s2;

p(s1) := pos1;
p(s2) := pos2;

distance(pos1, pos1) := 0;
distance(pos1, pos2) := 10;

distance(pos2, pos1) := 10;
distance(pos2, pos2) := 0;

id(pos1) := 1;
id(pos2) := 2;

[start] newImages := 0;
[start] transmittedImages := 0;

[start] image_taken(s1) := 0;
[start] image_taken(s2) := 0;

[start] pos := pos1;

[start] visited(pos1) := true;
[start] visited(pos2) := false;

[start] charging := false;
[start] transmitting := false;
[start] observing := false;
[start] moving := false;

[end] image_taken(s1) == 1;
[end] image_taken(s2) == 1;
[end] transmittedImages == 2;
