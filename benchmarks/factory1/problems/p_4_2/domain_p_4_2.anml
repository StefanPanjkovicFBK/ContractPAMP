constant integer steps;

fluent boolean running;
fluent boolean process_finished;
fluent integer completed_steps;
fluent integer battery;

action startprocess() {
    duration := 95;

    [start] not process_finished;
    [start] running := true;

    [end] running := false;
    [end] process_finished := true;
};

action work() {
    duration := 20;

    [start] completed_steps < steps;

    [all] running;

    [end] completed_steps := completed_steps + 1;
};

action cooldown() {
    duration := 2;

    [start] battery > 0;

    [all] running;

    [end] battery := battery - 1;
};