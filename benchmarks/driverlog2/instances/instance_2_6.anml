instance Location L1, L2;

distance_lb(L1, L1) := 0;
distance_lb(L1, L2) := 10;
distance_lb(L2, L1) := 10;
distance_lb(L2, L2) := 0;

distance_ub(L1, L1) := 0;
distance_ub(L1, L2) := 110;
distance_ub(L2, L1) := 110;
distance_ub(L2, L2) := 0;

id(L1) := 1;
id(L2) := 2;

[start] truck_at(L1) := true;
[start] truck_at(L2) := false;

[start] loc_packages(L1) := 6;
[start] loc_packages(L2) := 0;
[start] truck_packages := 0;

[start] loading := false;
[start] loaded := false;

[end] loc_packages(L2) == 6;
