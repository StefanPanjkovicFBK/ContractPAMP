@TIME_DOMAIN continuous

MODULE T_CHARGE

VAR location : {OFF, ON};
    __CLOCK__c : clock;
    start : boolean;
    end : boolean;

IVAR EVENT : {CHARGE_START, CHARGE_END, STUTTER};

INIT (location = OFF) &
     (__CLOCK__c = 0);

TRANS

(EVENT = STUTTER -> location = next(location) & next(__CLOCK__c) = __CLOCK__c) &

(EVENT = CHARGE_START -> location = OFF & next(location) = ON & next(__CLOCK__c) = 0) &

(EVENT = CHARGE_END -> location = ON & next(location) = OFF & next(__CLOCK__c) = __CLOCK__c) &

(start <-> EVENT = CHARGE_START) &

(end <-> EVENT = CHARGE_END);


MODULE T_DSN

VAR location : {OFF, ON};
    __CLOCK__c : clock;
    start : boolean;
    end : boolean;

IVAR EVENT : {DSN_START, DSN_END, STUTTER};

INIT (location = OFF) &
     (__CLOCK__c = 0);

TRANS

(EVENT = STUTTER -> location = next(location) & next(__CLOCK__c) = __CLOCK__c) &

(EVENT = DSN_START -> location = OFF & next(location) = ON & next(__CLOCK__c) = 0) &

(EVENT = DSN_END -> location = ON & next(location) = OFF & next(__CLOCK__c) = __CLOCK__c) &

(start <-> EVENT = DSN_START) &

(end <-> EVENT = DSN_END);


MODULE T_SBO

VAR location : {OFF, ON};
    __CLOCK__c : clock;
    start : boolean;
    end : boolean;

IVAR EVENT : {SBO_START, SBO_END, STUTTER};

INIT (location = OFF) &
     (__CLOCK__c = 0);

TRANS

(EVENT = STUTTER -> location = next(location) & next(__CLOCK__c) = __CLOCK__c) &

(EVENT = SBO_START -> location = OFF & next(location) = ON & next(__CLOCK__c) = 0) &

(EVENT = SBO_END -> location = ON & next(location) = OFF & next(__CLOCK__c) = __CLOCK__c) &

(start <-> EVENT = SBO_START) &

(end <-> EVENT = SBO_END);


MODULE T_TCM

VAR location : {OFF, ON};
    __CLOCK__c : clock;
    start : boolean;
    end : boolean;

IVAR EVENT : {TCM_START, TCM_END, STUTTER};

INIT (location = OFF) &
     (__CLOCK__c = 0);

TRANS

(EVENT = STUTTER -> location = next(location) & next(__CLOCK__c) = __CLOCK__c) &

(EVENT = TCM_START -> location = OFF & next(location) = ON & next(__CLOCK__c) = 0) &

(EVENT = TCM_END -> location = ON & next(location) = OFF & next(__CLOCK__c) = __CLOCK__c) &

(start <-> EVENT = TCM_START) &

(end <-> EVENT = TCM_END);


MODULE main

VAR

global_clock : clock;

tCHARGE : T_CHARGE();

tDSN : T_DSN();

tSBO : T_SBO();

tTCM : T_TCM();

soc : real;

INIT

(global_clock = 0) &

(soc = 200);

TRANS

(global_clock = next(global_clock)) &

(tCHARGE.EVENT = CHARGE_START -> soc >= 0) &

(tCHARGE.EVENT = CHARGE_END -> ((next(soc) - soc >= 4.0 * tCHARGE.__CLOCK__c) & (next(soc) - soc <= 5.0 * tCHARGE.__CLOCK__c))) &

(tDSN.EVENT = DSN_START -> soc >= 2.2 * tDSN.__CLOCK__c) &

(tDSN.EVENT = DSN_END -> ((soc - next(soc) >= 2.0 * tDSN.__CLOCK__c) & (soc - next(soc) <= 2.2 * tDSN.__CLOCK__c))) &

(tSBO.EVENT = SBO_START -> soc >= 0.2 * tSBO.__CLOCK__c) &

(tSBO.EVENT = SBO_END -> ((soc - next(soc) >= 0.1 * tSBO.__CLOCK__c) & (soc - next(soc) <= 0.2 * tSBO.__CLOCK__c))) &

(tTCM.EVENT = TCM_START -> soc >= 1.1 * tTCM.__CLOCK__c) &

(tTCM.EVENT = TCM_END -> ((soc - next(soc) >= 0.9 * tTCM.__CLOCK__c) & (soc - next(soc) <= 1.1 * tTCM.__CLOCK__c)));

INVARSPEC

soc >= 40;



