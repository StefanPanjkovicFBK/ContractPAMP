instance Position pos1, pos2, pos3, pos4;
instance Body s1, s2, s3, s4;

p(s1) := pos1;
p(s2) := pos2;
p(s3) := pos3;
p(s4) := pos4;

distance(pos1, pos1) := 0;
distance(pos1, pos2) := 10;
distance(pos1, pos3) := 10;
distance(pos1, pos4) := 10;

distance(pos2, pos1) := 10;
distance(pos2, pos2) := 0;
distance(pos2, pos3) := 10;
distance(pos2, pos4) := 10;

distance(pos3, pos1) := 10;
distance(pos3, pos2) := 10;
distance(pos3, pos3) := 0;
distance(pos3, pos4) := 10;

distance(pos4, pos1) := 10;
distance(pos4, pos2) := 10;
distance(pos4, pos3) := 10;
distance(pos4, pos4) := 0;

id(pos1) := 1;
id(pos2) := 2;
id(pos3) := 3;
id(pos4) := 4;

[start] newImages := 0;
[start] transmittedImages := 0;

[start] image_taken(s1) := 0;
[start] image_taken(s2) := 0;
[start] image_taken(s3) := 0;
[start] image_taken(s4) := 0;

[start] pos := pos1;

[start] visited(pos1) := true;
[start] visited(pos2) := false;
[start] visited(pos3) := false;
[start] visited(pos4) := false;

[start] charging := false;
[start] transmitting := false;
[start] observing := false;
[start] moving := false;

[end] image_taken(s1) == 1;
[end] image_taken(s2) == 1;
[end] image_taken(s3) == 1;
[end] image_taken(s4) == 1;
[end] transmittedImages == 4;
