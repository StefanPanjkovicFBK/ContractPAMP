instance Position pos1;
instance Body s1;

p(s1) := pos1;

distance(pos1, pos1) := 0;

id(pos1) := 1;

[start] newImages := 0;
[start] transmittedImages := 0;

[start] image_taken(s1) := 0;

[start] pos := pos1;

[start] visited(pos1) := true;

[start] charging := false;
[start] transmitting := false;
[start] observing := false;
[start] moving := false;

[end] image_taken(s1) == 2;
[end] transmittedImages == 2;
