instance Item empty1, item1, empty2;

id(empty1) := 0;
id(item1) := 1;
id(empty2) := 2;

[start] holding(empty1) := true;
[start] holding(item1) := false;
[start] holding(empty2) := false;

[start] fixed(empty1) := true;
[start] fixed(item1) := false;
[start] fixed(empty2) := true;

[end] fixed(item1);
[end] holding(empty2);